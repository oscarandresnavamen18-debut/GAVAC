# ==============================================================================
# CONFIGURACIÓN DE ENTORNO (PROYECTO GAVAC)
# ==============================================================================
# INSTRUCCIONES PARA EL EQUIPO:
# 1. crea un archivo dentro del backend" .env" .
# 2. Pide a Elian (Admin de BD) la URL de conexión real de Supabase por privado.
# 3. Pega esa URL completa en la variable DATABASE_URL de abajo.
# 4. ¡IMPORTANTE! Nunca subas el archivo ".env" a GitHub (ya está en .gitignore).
# ==============================================================================

# Clave JWT: usa una cadena aleatoria larga y privada.
AUTH_SECRET_KEY=genere-una-clave-aleatoria-larga

# Solo activar para desarrollo local con una base vacía.
AUTO_CREATE_TABLES=false

# Orígenes permitidos separados por comas.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Activar en producción cuando la aplicación use HTTPS.
COOKIE_SECURE=false

# URL de conexión a la base de datos (PostgreSQL / Supabase)
# Formato: postgresql://postgres:[CONTRASEÑA]@db.[PROJECT_ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:GestionGanadera@db.ivqjwnwtnylhxiavkxrw.supabase.co:5432/postgres